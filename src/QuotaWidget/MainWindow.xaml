<Window x:Class="QuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuotaWidget"
        Height="44"
        SizeToContent="Width"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="#141517"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
        Typography.NumeralAlignment="Tabular"
        Loaded="Window_Loaded">

    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu">
            <MenuItem x:Name="MenuRefresh" Header="Refresh now" Click="MenuRefresh_Click" />
            <Separator />
            <MenuItem x:Name="MenuOpenConfig" Header="Open config" Click="MenuOpenConfig_Click" />
            <MenuItem x:Name="MenuReloadConfig" Header="Reload config" Click="MenuReloadConfig_Click" />
            <Separator />
            <MenuItem x:Name="MenuExit" Header="Exit" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootGrid" Background="Transparent"
          MouseEnter="Widget_MouseEnter" MouseLeave="Widget_MouseLeave">

        <!-- Outer Bar Container (matching rounded container to window size) -->
        <Border x:Name="OuterBarBorder" Background="#141517" BorderBrush="#12FFFFFF" BorderThickness="1"
                CornerRadius="8" Padding="6,4" VerticalAlignment="Center">
            <StackPanel x:Name="BarContainer" Orientation="Horizontal" VerticalAlignment="Center" />
        </Border>

        <!-- Hover Popup -->
        <Popup x:Name="HoverPopup" Placement="Top" PlacementTarget="{Binding ElementName=RootGrid}"
               AllowsTransparency="True" StaysOpen="True">
            <Border x:Name="PopupOuterBorder" Background="#141517" BorderBrush="#12FFFFFF" BorderThickness="1"
                    CornerRadius="12" Padding="14" Width="340" Margin="0,0,0,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="2,0,2,12">
                        <TextBlock x:Name="PopupTitle" Text="AI quotas" FontWeight="SemiBold" FontSize="13" Foreground="#f3f4f6"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Ellipse x:Name="PopupStatusDot" Width="6" Height="6" Fill="#10b981" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="PopupStatusDotGlow" BlurRadius="6" ShadowDepth="0" Color="#10b981" Opacity="0.6" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="PopupHeaderUpdate" Text="--:--" FontSize="11" Foreground="#6b7280"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable accounts container -->
                    <ScrollViewer Grid.Row="1" x:Name="PopupScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PopupAccountsContainer" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>

    </Grid>
</Window>
